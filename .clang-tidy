Checks: >
  -*,
  bugprone-*,
  readability-*,
  performance-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -readability-implicit-bool-conversion

CheckOptions:
  readability-function-cognitive-complexity.IgnoreMacros: true

# Our headers, but not the ones a build wrote. sdkconfig.h is generated by
# idf.py from Kconfig and is full of `#define CONFIG_X -1`, which every macro
# check has an opinion about and nobody can act on.
HeaderFilterRegex: '.*/(tmc2209|rpc|shared|firmware)/.*'
ExcludeHeaderFilterRegex: '.*/build/.*'

WarningsAsErrors: ''

FormatStyle: none
