Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - bugprone-*
      - readability-*
      - performance-*
    Remove:
      # ESP-IDF headers and our register tables are full of magic constants and
      # short names by design; these fire on nearly every line.
      - readability-magic-numbers
      - readability-identifier-length
      - readability-braces-around-statements
      - bugprone-easily-swappable-parameters
      - readability-implicit-bool-conversion
    CheckOptions:
      readability-function-cognitive-complexity.IgnoreMacros: true

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: No

# Without this, hover dumps the comment verbatim, so tmc2209.h's @brief/@param/
# @retval blocks show up as literal text with the underscores backslash-escaped.
# Needs clangd 20 or newer; older builds ignore the key.
Documentation:
  CommentFormat: Doxygen
