use flake

watch_file flake.nix
watch_file flake.lock
while read -r one; do watch_file "$one"; done < <(find . -name module.nix -not -path './.git/*')

# basedpyright finds installed packages through this venv, discovered by name at
# the workspace root. Built over the devshell python, rebuilt when that moves.
real="$(readlink -f "$(command -v python)")"
want="$(dirname "$real")"
have="$(sed -n 's/^home = //p' .venv/pyvenv.cfg 2>/dev/null)"
if [ "$want" != "$have" ]; then
  rm -rf .venv
  "$real" -m venv --system-site-packages .venv
fi
