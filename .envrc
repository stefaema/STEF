use flake

# The editor resolves imports through an interpreter and only trusts a real venv
# layout, so PATH alone does not reach it. This builds one over the devshell's
# python, and rebuilds it whenever that python moves.
real="$(readlink -f "$(command -v python)")"
want="$(dirname "$real")"
have="$(sed -n 's/^home = //p' .venv/pyvenv.cfg 2>/dev/null)"
if [ "$want" != "$have" ]; then
  rm -rf .venv
  "$real" -m venv --system-site-packages .venv
fi
