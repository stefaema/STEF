# clangd config for the host-native unit tests.
#

CompileFlags:
  CompilationDatabase: build

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - bugprone-*
      - readability-*
    Remove:
      - readability-magic-numbers
      - readability-identifier-length
      - readability-function-cognitive-complexity

InlayHints:
  Enabled: Yes
  ParameterNames: Yes

# Same as firmware/src/.clangd: render the library's doxygen blocks as sections
# instead of literal @brief text. The tests hover the same headers.
Documentation:
  CommentFormat: Doxygen
