{
    "version": "2.0.0",
    // ci_cd.run re-execs itself into its own nix devshell, so these need no
    // wrapper. The idf.py tasks do: only firmware's devshell has the toolchain.
    "tasks": [
        {
            "label": "ci: lint",
            "detail": "Format, lint and type verdicts over every tracked file.",
            "type": "shell",
            "command": "python -m ci_cd.run lint",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: lint (staged only)",
            "type": "shell",
            "command": "python -m ci_cd.run lint --staged",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: fmt (check)",
            "type": "shell",
            "command": "python -m ci_cd.run fmt",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: fmt --fix",
            "detail": "Rewrites files. This is what formats the repository.",
            "type": "shell",
            "command": "python -m ci_cd.run fmt --fix",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: build (every module)",
            "type": "shell",
            "command": "python -m ci_cd.run build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: build (one module)",
            "type": "shell",
            "command": "python -m ci_cd.run build ${input:module}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: test (every module)",
            "detail": "Runs lint, then builds and unit tests everything. What develop demands.",
            "type": "shell",
            "command": "python -m ci_cd.run test",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: test (one module)",
            "detail": "Tests only, no lint and no build.",
            "type": "shell",
            "command": "python -m ci_cd.run test ${input:module}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: integration",
            "detail": "Test, plus the cross-module checks. What main demands.",
            "type": "shell",
            "command": "python -m ci_cd.run integration",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: verify-for (destination branch)",
            "type": "shell",
            "command": "python -m ci_cd.run verify-for ${input:destination}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "ci: commit-msg (check a message file)",
            "type": "shell",
            "command": "python -m ci_cd.run commit-msg ${input:commitMsgFile}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: list modules",
            "type": "shell",
            "command": "python -m ci_cd.run --list",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "firmware: build (idf.py)",
            "type": "shell",
            "command": "nix develop ./firmware --command idf.py -C firmware/src build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "firmware: reconfigure (refresh compile_commands.json)",
            "detail": "Run after adding a component, a source file or an include dir, otherwise clangd keeps resolving against the old build.",
            "type": "shell",
            "command": "nix develop ./firmware --command idf.py -C firmware/src reconfigure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "firmware: flash + monitor",
            "type": "shell",
            "command": "nix develop ./firmware --command idf.py -C firmware/src -p ${input:serialPort} flash monitor",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "firmware: monitor",
            "type": "shell",
            "command": "nix develop ./firmware --command idf.py -C firmware/src -p ${input:serialPort} monitor",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "firmware: fullclean",
            "type": "shell",
            "command": "nix develop ./firmware --command idf.py -C firmware/src fullclean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "unit tests: configure (refresh compile_commands.json)",
            "detail": "Generates firmware/test/unit/build/compile_commands.json, which is what clangd reads inside the test tree.",
            "type": "shell",
            "command": "nix develop ./firmware --command cmake -S firmware/test/unit -B firmware/test/unit/build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "module",
            "type": "pickString",
            "description": "Module (`ci: list modules` shows what discovery found)",
            "options": [
                "bench_api",
                "ci_cd",
                "dev_base",
                "firmware",
                "fw_api",
                "gui",
                "paths",
                "rpc",
                "scan_api",
                "tmc2209",
                "transport"
            ]
        },
        {
            "id": "destination",
            "type": "pickString",
            "description": "Branch the work is headed for",
            "options": [
                "develop",
                "main"
            ],
            "default": "develop"
        },
        {
            "id": "commitMsgFile",
            "type": "promptString",
            "description": "Path to the commit message file",
            "default": ".git/COMMIT_EDITMSG"
        },
        {
            "id": "serialPort",
            "type": "promptString",
            "description": "Serial port of the ESP32 (firmware/utils/find_esp32_port.py finds it)",
            "default": "/dev/ttyACM0"
        }
    ]
}
