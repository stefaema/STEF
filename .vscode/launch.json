{
    "version": "0.2.0",
    "configurations": [
        {
            // Host-native tests are a plain x86 binary, so ordinary gdb debugs
            // them. Nothing here touches the board.
            "name": "Debug unit tests (host gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/firmware/test/unit/build/unit_tests",
            "args": [],
            "cwd": "${workspaceFolder}/firmware/test/unit",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "unit tests: build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: pytest (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-vv"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}
